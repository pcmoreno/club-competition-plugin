# What `git archive` leaves out of a release zip: build tooling, static analysis
# config and the frontend sources. build/ is the compiled output and does ship —
# SiteGround has no Node, so it is committed rather than built on the host.
/.gitattributes   export-ignore
/.gitignore       export-ignore
/.nvmrc           export-ignore
/.php-cs-fixer.dist.php export-ignore
/CLAUDE.md        export-ignore
/package.json     export-ignore
/package-lock.json export-ignore
/phpstan.neon     export-ignore
/phpstan-baseline.neon export-ignore
/phpstan-bootstrap.php export-ignore
/postcss.config.js export-ignore
/tailwind.config.js export-ignore
/webpack.config.js export-ignore
/css              export-ignore
/js               export-ignore
